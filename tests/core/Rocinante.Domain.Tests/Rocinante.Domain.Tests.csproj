<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rocinante.Domain.Tests</RootNamespace>
    <!-- The constitution asks for at least 80 % domain coverage: every test run enforces it. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverlet --coverlet-include "[Rocinante.Domain]*" --coverlet-output-format cobertura --coverlet-threshold 80 --coverlet-threshold-type line --coverlet-threshold-type branch</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\core\Rocinante.Domain\Rocinante.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rules for mentions are shared with the interface, which passes the same cases. -->
    <None Include="..\..\..\src\contracts\mentions.json" Link="contract\mentions.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Shouldly" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" Version="10.1.1" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
