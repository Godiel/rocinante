<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that touches the outside world: the .rocinante file, the settings and the log. -->
  <PropertyGroup>
    <RootNamespace>Rocinante.Infrastructure</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rocinante.Application\Rocinante.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Schema migrations, applied in order by their numeric prefix. -->
    <EmbeddedResource Include="Persistence\Migrations\*.sql" LogicalName="migrations/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Rocinante.Infrastructure.Tests" />
  </ItemGroup>

</Project>
